val artwork by NowPlayingService.artwork.collectAsState()

if (artwork != null) {
    Image(
        bitmap = artwork!!.asImageBitmap(),
        contentDescription = "Now playing artwork",
        contentScale = ContentScale.Crop,
        modifier = Modifier
            .size(88.dp)
            .clip(RoundedCornerShape(16.dp))
    )
} else {
    // Existing blurred gradient box fallback
}
